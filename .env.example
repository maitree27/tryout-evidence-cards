# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Only used by the demo-data script (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI wording of feedback (only ever receives finished scores, never video or names).
# If GEMINI_API_KEY is set it is used first; otherwise OpenAI; otherwise a plain template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o
