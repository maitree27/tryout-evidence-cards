# Use ONE of these. OpenAI is used if OPENAI_API_KEY is set, otherwise OpenRouter.
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o
# OPENROUTER_API_KEY=your-key-here
# OPENROUTER_MODEL=google/gemini-2.5-flash
# Only needed on Vercel (auto-added when you create a Blob store):
BLOB_READ_WRITE_TOKEN=
